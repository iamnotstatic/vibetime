{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npm run build 1>&2 || exit 2",
            "statusMessage": "Running build before commit..."
          }
        ]
      }
    ]
  }
}
